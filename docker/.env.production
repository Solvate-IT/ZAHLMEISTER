# Zahlmeister production configuration. Secrets/private overrides belong in .env.
PROJECT_NAME=zahlmeister
POSTGRES_DB=zahlmeister
POSTGRES_USER=zahlmeister
# POSTGRES_PASSWORD=  # set inside .env
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
# DATABASE_URL=  # set inside .env
DATABASE_URL_FILE=/run/secrets/production/database_url
ENVIRONMENT=production
# APP_SECRET=  # set inside .env
APP_SECRET_FILE=/run/secrets/production/app_secret
CORS_ORIGINS=https://zahlmeister.solvate.at,capacitor://localhost,https://localhost
BACKEND_PORT=
FRONTEND_PORT=
MAILPIT_PORT=
APP_HOST=zahlmeister.solvate.at
TRAEFIK_NETWORK=traefik
APP_RUNTIME_UID=10001
APP_RUNTIME_GID=10001
PUBLIC_APP_URL=https://zahlmeister.solvate.at
OAUTH_CALLBACK_BASE_URL=https://zahlmeister.solvate.at
PLATFORM_ADMIN_EMAILS=administration@example.com
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=administration@example.com
# PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=  # set inside .env
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD_FILE=/run/secrets/production/platform_admin_password
PLATFORM_ADMIN_BOOTSTRAP_NAME=Zahlmeister Administration
LOG_LEVEL=INFO
LOG_FORMAT=json
TRUST_PROXY_HEADERS=true
READINESS_REQUIRE_WORKER=true
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_SECONDS=60
# MONITORING_TOKEN=  # set inside .env
MONITORING_TOKEN_FILE=/run/secrets/production/monitoring_token
JOB_MAX_ATTEMPTS=7
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=900
JOB_RETRY_JITTER=0.20
JOB_STALE_AFTER_SECONDS=900
MAIL_DELIVERY_MODE=smtp
MAIL_FROM_ADDRESS=mail@example.com
MAIL_FROM_NAME=Zahlmeister
MAIL_REPLY_DOMAIN=example.com
CONTACT_RECIPIENT=Support@Solvate.at
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mail@example.com
# SMTP_PASSWORD=  # set inside .env
SMTP_PASSWORD_FILE=/run/secrets/production/platform_smtp_password
SMTP_STARTTLS=true
PLATFORM_IMAP_HOST=imap.example.com
PLATFORM_IMAP_PORT=993
PLATFORM_IMAP_USERNAME=mail@example.com
# PLATFORM_IMAP_PASSWORD=  # set inside .env
PLATFORM_IMAP_PASSWORD_FILE=/run/secrets/production/platform_imap_password
PLATFORM_IMAP_SSL=true
PLATFORM_IMAP_STARTTLS=false
PLATFORM_IMAP_FOLDER=INBOX
INFOBIP_OAUTH_CLIENT_ID=
# INFOBIP_OAUTH_CLIENT_SECRET=  # set inside .env
INFOBIP_OAUTH_CLIENT_SECRET_FILE=
INFOBIP_OAUTH_SCOPES=api_read message:send subscriptions:manage
INFOBIP_OAUTH_AUTHORIZE_URL=https://oneapi.infobip.com/exchange/1/oauth/authorize
INFOBIP_OAUTH_TOKEN_URL=https://oneapi.infobip.com/exchange/1/oauth/token
INFOBIP_DEFAULT_BASE_URL=https://api.infobip.com
MICROSOFT365_CLIENT_ID=
# MICROSOFT365_CLIENT_SECRET=  # set inside .env
MICROSOFT365_CLIENT_SECRET_FILE=
MICROSOFT365_TENANT=organizations
MICROSOFT365_SCOPES=openid profile offline_access User.Read Mail.Read Mail.Send
MICROSOFT365_GRAPH_URL=https://graph.microsoft.com/v1.0
PONTO_CONNECT_ENVIRONMENT=live
PONTO_CONNECT_CLIENT_ID=
# PONTO_CONNECT_CLIENT_SECRET=  # set inside .env
PONTO_CONNECT_CLIENT_SECRET_FILE=
PONTO_CONNECT_API_URL=https://api.ibanity.com/ponto-connect
PONTO_CONNECT_AUTHORIZE_URL=https://authorization.myponto.com/oauth2/auth
PONTO_CONNECT_TOKEN_URL=https://api.ibanity.com/ponto-connect/oauth2/token
PONTO_CONNECT_SCOPE=offline_access ai name
PONTO_CONNECT_CERT_PATH=/run/secrets/ponto/client.crt
PONTO_CONNECT_KEY_PATH=/run/secrets/ponto/client.key
# PONTO_CONNECT_KEY_PASSWORD=  # set inside .env
PONTO_CONNECT_KEY_PASSWORD_FILE=
MOLLIE_OAUTH_CLIENT_ID=
# MOLLIE_OAUTH_CLIENT_SECRET=  # set inside .env
MOLLIE_OAUTH_CLIENT_SECRET_FILE=
MOLLIE_OAUTH_AUTHORIZE_URL=https://my.mollie.com/oauth2/authorize
MOLLIE_OAUTH_TOKEN_URL=https://api.mollie.com/oauth2/tokens
MOLLIE_API_URL=https://api.mollie.com/v2
MOLLIE_OAUTH_SCOPES=organizations.read profiles.read payments.read payments.write
MOLLIE_TEST_MODE=false
# MOLLIE_BILLING_API_KEY=  # set inside .env
MOLLIE_BILLING_API_KEY_FILE=/run/secrets/production/mollie_billing_api_key
# MOLLIE_BILLING_WEBHOOK_SECRET=  # set inside .env
MOLLIE_BILLING_WEBHOOK_SECRET_FILE=/run/secrets/production/mollie_billing_webhook_secret
MOLLIE_BILLING_ENVIRONMENT=live
MOLLIE_BILLING_RECOVERY_MAX_PAGES=100
MOLLIE_BILLING_MAX_RETRIES=3
MOLLIE_BILLING_GRACE_DAYS=7
BILLING_SELLER_LEGAL_NAME=
BILLING_SELLER_COUNTRY=AT
BILLING_SELLER_EMAIL=
BILLING_SELLER_STREET_AND_NUMBER=
BILLING_SELLER_POSTAL_CODE=
BILLING_SELLER_CITY=
BILLING_SELLER_REGION=
BILLING_SELLER_VAT_NUMBER=
BILLING_SELLER_ORGANIZATION_NUMBER=
BILLING_SELLER_EU_OSS_ENABLED=false
# GOOGLE_TRANSLATE_API_KEY=  # set inside .env
GOOGLE_TRANSLATE_API_KEY_FILE=
GOOGLE_TRANSLATE_API_URL=https://translation.googleapis.com/language/translate/v2
