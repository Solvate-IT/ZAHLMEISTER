PROJECT_NAME=zahlmeister
POSTGRES_DB=zahlmeister
POSTGRES_USER=zahlmeister
POSTGRES_PASSWORD=zahlmeister
DATABASE_URL=postgresql+asyncpg://zahlmeister:zahlmeister@db:5432/zahlmeister
ENVIRONMENT=development
APP_SECRET=zahlmeister-development-secret-change-me
CORS_ORIGINS=http://localhost:3003,capacitor://localhost,https://localhost
BACKEND_PORT=8003
FRONTEND_PORT=3003
MAILPIT_PORT=8028
APP_HOST=zahlmeister.localhost
TRAEFIK_NETWORK=traefik

PUBLIC_APP_URL=http://localhost:3003
OAUTH_CALLBACK_BASE_URL=http://localhost:8003
MAIL_DELIVERY_MODE=smtp
MAIL_FROM_ADDRESS=noreply@zahlmeister.local
MAIL_FROM_NAME=Zahlmeister
# Optional in development. Production uses a real domain that routes reply+*@domain
# to the central inbound mailbox.
MAIL_REPLY_DOMAIN=
CONTACT_RECIPIENT=Support@Solvate.at
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
# Mailpit is SMTP-only, therefore central reply import is disabled locally by default.
# Point these fields at a development IMAP mailbox when inbound reply routing must be tested.
PLATFORM_IMAP_HOST=
PLATFORM_IMAP_PORT=993
PLATFORM_IMAP_USERNAME=
PLATFORM_IMAP_PASSWORD=
PLATFORM_IMAP_SSL=true
PLATFORM_IMAP_STARTTLS=false
PLATFORM_IMAP_FOLDER=INBOX

# Platform administrator. No default password is stored in the repository.
# Use docker/manage.sh -> "Set/reset platform admin password" after the stack is available.
PLATFORM_ADMIN_EMAILS=administration@zahlmeister.at
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=administration@zahlmeister.at
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=
PLATFORM_ADMIN_BOOTSTRAP_NAME=Zahlmeister Administration

# Optional Infobip OAuth app. If left empty, customers can connect their own
# Infobip account with an API key instead.
INFOBIP_OAUTH_CLIENT_ID=
INFOBIP_OAUTH_CLIENT_SECRET=
INFOBIP_OAUTH_SCOPES=api_read message:send subscriptions:manage
INFOBIP_OAUTH_AUTHORIZE_URL=https://oneapi.infobip.com/exchange/1/oauth/authorize
INFOBIP_OAUTH_TOKEN_URL=https://oneapi.infobip.com/exchange/1/oauth/token
INFOBIP_DEFAULT_BASE_URL=https://api.infobip.com

# Microsoft 365 internal email via Microsoft Graph. Register one multi-tenant
# Entra application for Zahlmeister; customers connect their own work/school mailbox via OAuth.
MICROSOFT365_CLIENT_ID=
MICROSOFT365_CLIENT_SECRET=
MICROSOFT365_TENANT=organizations
MICROSOFT365_SCOPES=openid profile offline_access User.Read Mail.Read Mail.Send
MICROSOFT365_GRAPH_URL=https://graph.microsoft.com/v1.0

# Ponto Connect sandbox. These are Zahlmeister's technical sandbox credentials,
# not credentials entered by individual Zahlmeister customers. Customers authorize
# their own Ponto organization and bank accounts through Ponto's OAuth flow.
PONTO_CONNECT_ENVIRONMENT=sandbox
PONTO_CONNECT_CLIENT_ID=
PONTO_CONNECT_CLIENT_SECRET=
PONTO_CONNECT_API_URL=https://api.ibanity.com/ponto-connect
# Leave empty to select the official sandbox authorization URL automatically.
PONTO_CONNECT_AUTHORIZE_URL=
PONTO_CONNECT_TOKEN_URL=https://api.ibanity.com/ponto-connect/oauth2/token
PONTO_CONNECT_SCOPE=offline_access ai name
# Store the sandbox certificate/key locally in docker/secrets/ponto/. They are ignored by Git.
PONTO_CONNECT_CERT_PATH=/run/secrets/ponto/client.crt
PONTO_CONNECT_KEY_PATH=/run/secrets/ponto/client.key
PONTO_CONNECT_KEY_PASSWORD=

# Optional online payments via Mollie Connect. Each customer connects their own
# Mollie account and Mollie bills that account directly.
MOLLIE_OAUTH_CLIENT_ID=
MOLLIE_OAUTH_CLIENT_SECRET=
MOLLIE_OAUTH_AUTHORIZE_URL=https://my.mollie.com/oauth2/authorize
MOLLIE_OAUTH_TOKEN_URL=https://api.mollie.com/oauth2/tokens
MOLLIE_API_URL=https://api.mollie.com/v2
MOLLIE_OAUTH_SCOPES=organizations.read profiles.read payments.read payments.write
MOLLIE_API_URL=https://api.mollie.com/v2
MOLLIE_OAUTH_SCOPES=organizations.read profiles.read payments.read payments.write
MOLLIE_TEST_MODE=false

# Optional platform-wide automatic message-template translation. This credential
# belongs to the Zahlmeister installation and is never exposed to customer settings.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_API_URL=https://translation.googleapis.com/language/translate/v2

# Production/operations defaults; harmless in development.
LOG_LEVEL=INFO
LOG_FORMAT=text
TRUST_PROXY_HEADERS=true
READINESS_REQUIRE_WORKER=false
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_SECONDS=60
MONITORING_TOKEN=
JOB_MAX_ATTEMPTS=7
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=900
JOB_RETRY_JITTER=0.20
JOB_STALE_AFTER_SECONDS=900
