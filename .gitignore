# ============================================================
# ServiceHUB - Git Ignore
# ============================================================

# ------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Certificates / private keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ------------------------------------------------------------
# Python / FastAPI
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

.python-version

.venv/
venv/
env/
ENV/

pip-wheel-metadata/
*.egg-info/
.eggs/
dist/
build/

# Test / coverage / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.trivy-cache

# ------------------------------------------------------------
# Node / Next.js
# ------------------------------------------------------------
node_modules/

.next/
out/
dist/
build/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/cache/
.pnpm-store/

# Next.js / Vercel
.vercel/

# TypeScript
*.tsbuildinfo
#next-env.d.ts

# ------------------------------------------------------------
# Docker runtime data
# ------------------------------------------------------------
docker/backup/*
!docker/backup/.gitkeep

docker/data/
docker/volumes/
docker/tmp/

# Docker overrides that are developer-specific
docker-compose.override.yml
docker/docker-compose.override.yml

# ------------------------------------------------------------
# ServiceHUB runtime / uploaded data
# ------------------------------------------------------------
uploads/
storage/
media/
tmp/
temp/

backend/uploads/
backend/storage/
backend/media/

# Generated exports
exports/
backend/exports/

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------
*.log
logs/
backend/logs/
frontend/logs/

# ------------------------------------------------------------
# Database dumps / backups
# ------------------------------------------------------------
*.sql
*.sql.gz
*.dump
*.backup
*.bak

# SQLite - only if used locally/tests
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------
# IDE - PyCharm / IntelliJ
# ------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws

# VS Code - local developer configuration
.vscode/

# ------------------------------------------------------------
# OS generated files
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride

Thumbs.db
Thumbs.db:encryptable
Desktop.ini

# ------------------------------------------------------------
# Temporary / editor files
# ------------------------------------------------------------
*~
*.swp
*.swo
*.tmp
*.temp

# ------------------------------------------------------------
# Local development artifacts
# ------------------------------------------------------------
.cache/
.cache-loader/

# Local test output
test-results/
playwright-report/
blob-report/

# Screenshots generated by automated tests
screenshots/
