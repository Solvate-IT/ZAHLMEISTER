# ============================================================
# ZAHLMEISTER - Git Ignore
# ============================================================

# Environment / secrets
.env
.env.*
!.env.development
!.env.production

**/.env
**/.env.*
!**/.env.development
!**/.env.production

# Certificates / private keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Python / FastAPI
__pycache__/
*.py[cod]
*$py.class
*.so
.python-version
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.trivy-cache

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/cache/
.pnpm-store/
.vercel/
*.tsbuildinfo
#next-env.d.ts

# Docker runtime data
docker/backup/*
!docker/backup/.gitkeep
docker/data/
docker/volumes/
docker/tmp/
docker-compose.override.yml
docker/docker-compose.override.yml

# Runtime / uploaded data
uploads/
storage/
media/
tmp/
temp/
backend/uploads/
backend/storage/
backend/media/
exports/
backend/exports/

# Logs
*.log
logs/
backend/logs/
frontend/logs/

# Database dumps / backups
*.sql
*.sql.gz
*.dump
*.backup
*.bak
*.sqlite
*.sqlite3
*.db

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# OS generated files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
Desktop.ini

# Temporary / editor files
*~
*.swp
*.swo
*.tmp
*.temp
.cache/
.cache-loader/
test-results/
playwright-report/
blob-report/
screenshots/
